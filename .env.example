# AnandBus Environment Configuration
# Copy this file to .env for local development
# NEVER commit your actual .env file or production secrets to Git/GitHub!

# Django Security
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False

# Host & CSRF Configuration (comma-separated)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000

# Site URL (your Vercel production domain, e.g. https://anandbus.vercel.app)
SITE_URL=https://anandbus.vercel.app

# Database Connection
# Option 1: Hosted PostgreSQL (Neon, Supabase, Railway, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Local PostgreSQL (used when DATABASE_URL is not provided)
DB_NAME=anandbus_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP for booking confirmation and notification emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_16_digit_app_password
DEFAULT_FROM_EMAIL=AnandBus <your_email@gmail.com>

# Razorpay Payment Gateway (Test / Live)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Payment Gateway (Test / Live)
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX
